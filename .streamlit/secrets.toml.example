# .streamlit/secrets.toml 설정 예시
# 실제 API 키를 입력할 때는 이 파일을 복사하여 secrets.toml 로 이름을 변경한 뒤 키를 입력하세요.
OPENAI_API_KEY = ""
VECTOR_STORE_ID = ""
VECTOR_STORE_FILE_ID = ""
VECTOR_STORE_URL_ID = ""
RAG_PBL_MODEL = "gpt-4.1-mini"

# Firebase mode stays off until every private value below is supplied.
[firebase]
enabled = false
project_id = "health-quest-agent"
storage_bucket = "health-quest-agent.firebasestorage.app"

[firebase.service_account]
type = "service_account"
project_id = "health-quest-agent"
private_key_id = "PASTE_FROM_DOWNLOADED_JSON"
private_key = """-----BEGIN PRIVATE KEY-----
PASTE_FROM_DOWNLOADED_JSON
-----END PRIVATE KEY-----
"""
client_email = "PASTE_FROM_DOWNLOADED_JSON"
client_id = "PASTE_FROM_DOWNLOADED_JSON"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "PASTE_FROM_DOWNLOADED_JSON"
universe_domain = "googleapis.com"

# Google OIDC for Streamlit student/teacher login.
[auth]
redirect_uri = "http://localhost:8503/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_VALUE"

[auth.google]
client_id = "PASTE_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "PASTE_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[authz]
teacher_emails = ["teacher1@example.com", "teacher2@example.com"]
class_ids = ["1반", "2반", "3반", "4반", "5반"]
